{
    "name": "ai-content-studio/wordpress-plugin",
    "description": "AI Content Studio - Plateforme SaaS pour génération de contenu avec IA",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "AI Content Studio Team",
            "email": "support@aicontentstudio.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "ACS\\": "includes/",
            "ACS\\Admin\\": "includes/admin/",
            "ACS\\API\\": "includes/api/",
            "ACS\\Services\\": "includes/services/",
            "ACS\\Models\\": "includes/models/",
            "ACS\\WooCommerce\\": "includes/woocommerce/",
            "ACS\\Data\\": "includes/data/",
            "ACS\\Integrations\\": "includes/integrations/",
            "ACS\\Utils\\": "includes/utils/",
            "ACS\\Config\\": "includes/config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ACS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=WordPress --extensions=php --ignore=*/vendor/*,*/node_modules/* .",
        "phpcbf": "phpcbf --standard=WordPress --extensions=php --ignore=*/vendor/*,*/node_modules/* ."
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
